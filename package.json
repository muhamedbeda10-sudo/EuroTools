{
  "name": "quality-inspection",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --exclude 'tests/**'",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "create-admin": "tsx --conditions=react-server scripts/create-admin.ts",
    "emulators": "firebase emulators:start --only firestore,auth",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "dev:session": "tsx --conditions=react-server scripts/dev-session-cookie.ts",
    "test:integration": "vitest run tests/integrity.test.ts",
    "test:rules": "vitest run tests/rules.test.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "firebase-tools": "^15.30.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
