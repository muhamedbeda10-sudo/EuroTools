APP_ENV=development
INITIAL_CAPITAL_EGP=50000
SEED_SAMPLE_DATA=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Deployed API: per-user data in Firestore, authenticated by the caller's Firebase sign-in.
# STORE_BACKEND=firestore
# FIREBASE_PROJECT_ID=eurotools-a1ea6
# The real brokerage account (read-only) is shown only to these sign-ins: Firebase user IDs, comma-separated.
# Empty = nobody on the deployed app. The user ID is shown in Settings -> Market data -> Connections.
# A local run without sign-in may look only with the word "local".
# BROKER_ACCOUNT_UIDS=local
# The server's switch for real orders. Off unless set to true: with it off, no order can reach the broker.
# On, an order still needs the owner's own switch and limits (Settings -> Real trading) and their approval.
# LIVE_TRADING_ENABLED=false

# Running without the app open (app/background.py). Leave all three out and the server never acts by itself.
# CRON_SECRET: the hosting platform's secret for its timer; only a call carrying it wakes the server.
# BACKGROUND_KEY: the owner's sign-in, sealed by this server. Created in Settings -> Real trading, pasted here
#   by the owner. On a server without sign-in (local SQLite) the word "local" stands in for it.
# BACKGROUND_SECRET: optional. What the sealing key and the notification key are derived from; without it the
#   broker credentials above are used.
# CRON_SECRET=
# BACKGROUND_KEY=
# BACKGROUND_SECRET=
