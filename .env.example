# ─── Firebase project ────────────────────────────────────────────────────────
# On App Hosting these come from apphosting.yaml and the runtime service
# account, and this file does not exist. It is for local development.

# Client SDK. These reach the browser by design: they identify the project,
# they grant nothing. Access is decided server-side against the user document,
# and firestore.rules denies all client access to the database.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""

# Admin SDK. Leave empty when working against the emulators — they need no
# credentials, which is the point. Set them only to work against a real
# project, pointing at a service-account key that is never committed.
FIREBASE_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ─── Emulators ───────────────────────────────────────────────────────────────
# Setting either of these switches the Admin SDK to the local emulators and
# stops it asking for credentials. `npm run emulators` serves them on these
# ports.
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
GCLOUD_PROJECT="eurotools-qc-dev"

# ─── Display ─────────────────────────────────────────────────────────────────
# Timezone used to render every date. Read at build time, so changing it needs
# a rebuild.
NEXT_PUBLIC_QC_TIME_ZONE="Africa/Cairo"
