# ─── Firebase project (browser) ──────────────────────────────────────────────
# These reach the browser by design: they identify the project, they grant
# nothing. Every authorisation decision is made by firestore.rules, which runs
# on Google's side and re-reads the caller's account for each operation.
#
# Copy them from Firebase Console → Project settings → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""

# ─── Emulators (local development only) ──────────────────────────────────────
# Setting these points the app at the local emulators instead of the real
# project. Leave them empty in the build you deploy — they are inlined into the
# bundle, so a deployed build with them set would talk to nothing.
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# ─── Admin SDK (scripts only) ────────────────────────────────────────────────
# `npm run seed` and `npm run create-admin` write before any account exists to
# write with, so they use the Admin SDK and run outside the security rules by
# design. Against the emulators they need no credentials at all; against a real
# project, point GOOGLE_APPLICATION_CREDENTIALS at a service-account key that
# is never committed.
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
GCLOUD_PROJECT="eurotools-qc-dev"
FIREBASE_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ─── Display ─────────────────────────────────────────────────────────────────
# Timezone used to render every date. Inlined at build time, so changing it
# needs a rebuild.
NEXT_PUBLIC_QC_TIME_ZONE="Africa/Cairo"
