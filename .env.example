# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL. In production this is a Cloud SQL instance and the real value is
# held in Cloud Secret Manager, never in a file. Keep `connection_limit` — see
# "Connection pooling" in the README for why it is not the default.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/eurotools_dev?schema=public&connection_limit=5"

# ─── Firebase Authentication (client) ────────────────────────────────────────
# These reach the browser by design; they identify the project, they do not
# grant anything. Access is decided server-side against the User table.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""

# ─── Firebase Authentication (server) ────────────────────────────────────────
# On App Hosting the Admin SDK picks up the runtime service account on its own
# and both of these stay empty. Set them only for local development, pointing
# at a service-account key file that is never committed.
FIREBASE_PROJECT_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""

# ─── Display ─────────────────────────────────────────────────────────────────
# Timezone used to render every date. Read at build time, so changing it needs
# a rebuild.
NEXT_PUBLIC_QC_TIME_ZONE="Africa/Cairo"
