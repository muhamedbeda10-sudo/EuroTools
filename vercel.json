{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{.next,out,node_modules,app,components,lib,tests,.github}/**"
    }
  },
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/v1/background/look",
      "schedule": "* 6-13 * * 0-4"
    }
  ]
}
