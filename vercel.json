{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "{.next,out,node_modules,app,components,lib,tests,.github}/**"
    }
  },
  "regions": [
    "cdg1"
  ]
}
