// Quality Inspection — نظام فحص الجودة
//
// Flow: Raw Material Receiving → Analysis → Roughing → Post-Roughing Inspection →
// Heat Treatment → Visual + Hardness → Grinding → Post-Grinding Inspection →
// Finishing → Final Inspection + CMM → Final Quality Release.
//
// Stage, status and role are stored as strings constrained by the domain layer
// (`lib/domain/stages.ts`, `lib/domain/roles.ts`) rather than by native Postgres
// enums. The domain layer stays the single source of truth for the allowed
// values and for every checklist label, and re-wording a vocabulary entry never
// needs a schema migration.
//
// All timestamps are `timestamptz` so an auditor querying the database directly
// reads the same instant the application recorded, whatever the server locale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── people ─────────────────────────

/// A person allowed to sign records.
///
/// Firebase Authentication proves *who* someone is; this table decides *what
/// they may do*. Authorisation is read from here on every request, so clearing
/// `active` locks an account out immediately instead of waiting for a token to
/// expire. `role` is validated against `lib/domain/roles.ts`.
///
/// Accounts are created by an administrator — there is no self sign-up — and a
/// user is never deleted, only deactivated. Every record they signed keeps
/// pointing at them, which is the whole point of an audit trail.
model User {
  id          Int     @id @default(autoincrement())
  /// The Firebase Authentication UID; the only link to the identity provider.
  firebaseUid String  @unique
  email       String  @unique
  displayName String
  /// ADMIN | QUALITY_MANAGER | SUPERVISOR | INSPECTOR | VIEWER
  role        String
  /// Badge or payroll number, printed on inspection reports.
  employeeNo  String?
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Which administrator opened the account. Granting someone the authority to
  /// release parts is itself an auditable act.
  createdById  Int?
  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdUsers User[] @relation("UserCreatedBy")

  inspections      Inspection[]
  analysesRecorded Analysis[]
  partEvents       PartEvent[]
  auditedChanges   UserAuditEvent[] @relation("AuditActor")
  accessHistory    UserAuditEvent[] @relation("AuditSubject")

  @@index([role, active])
}

/// Administrative audit trail: who changed whose access, and when.
///
/// Granting somebody the authority to release product is itself a decision an
/// auditor will ask about, and `User` alone only says what is true now. This
/// table says how it got that way. Append-only, like `PartEvent`.
model UserAuditEvent {
  id Int      @id @default(autoincrement())
  at DateTime @default(now()) @db.Timestamptz(3)

  /// CREATED | ROLE_CHANGED | ACTIVATED | DEACTIVATED
  kind String

  /// The account that was changed.
  subjectId Int
  subject   User @relation("AuditSubject", fields: [subjectId], references: [id], onDelete: Restrict)

  /// The administrator who changed it.
  actorId   Int
  actorUser User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  fromValue String?
  toValue   String?

  @@index([subjectId, at])
  @@index([at])
}

// ───────────────────────── catalog ─────────────────────────

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?
  contact   String?
  notes     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lots      Lot[]
}

/// The part spec: everything the drawing and the material standard require.
model Material {
  id             Int     @id @default(autoincrement())
  partNumber     String  @unique
  materialNumber String?
  description    String?
  spec           String? // e.g. DIN 1.2379 / AISI D2
  drawingNumber  String?
  drawingRev     String?

  /// Required hardness window after heat treatment.
  hardnessMin  Float?
  hardnessMax  Float?
  hardnessUnit String @default("HRC")

  /// Required surface finish at final inspection (Ra, µm).
  surfaceFinishRa Float?

  /// Certificate types the lot must arrive with, comma-separated.
  requiredCerts String?

  /// Roughing allowance that must remain for the later stages (mm).
  roughingAllowance Float?

  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  features  MaterialFeature[]
  lots      Lot[]
  parts     Part[]
}

/// A dimension or GD&T callout an inspector measures at a given stage.
model MaterialFeature {
  id         Int      @id @default(autoincrement())
  materialId Int
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  /// Which inspection reads this feature: POST_ROUGHING | POST_GRINDING | FINAL
  stage String
  name  String
  /// DIMENSION | GDT
  kind  String @default("DIMENSION")

  nominal  Float?
  tolMinus Float   @default(0)
  tolPlus  Float   @default(0)
  unit     String  @default("mm")
  critical Boolean @default(false)

  /// GD&T only: the symbol and the max allowed deviation (0 … gdtLimit).
  gdtSymbol String?
  gdtLimit  Float?

  sortOrder Int @default(0)

  @@index([materialId, stage])
}

// ───────────────────── 1 & 2 · raw material ─────────────────────

model Lot {
  id         Int       @id @default(autoincrement())
  lotNumber  String    @unique
  materialId Int
  material   Material  @relation(fields: [materialId], references: [id])
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  receivedAt  DateTime @default(now()) @db.Timestamptz(3)
  poNumber    String?
  heatNumber  String?
  receivedQty Float
  unit        String   @default("pcs")

  /// PENDING | ACCEPTED | REJECTED — the receiving verdict (§1).
  status String  @default("PENDING")
  notes  String?

  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  certificates Certificate[]
  analyses     Analysis[]
  inspections  Inspection[]
  parts        Part[]

  @@index([status])
}

model Certificate {
  id       Int       @id @default(autoincrement())
  lotId    Int
  lot      Lot       @relation(fields: [lotId], references: [id], onDelete: Cascade)
  type     String // Mill Test Certificate / Heat Treatment / RoHS …
  number   String?
  issuedAt DateTime? @db.Timestamptz(3)
  received Boolean   @default(false)
  verified Boolean   @default(false)
  notes    String?

  @@index([lotId])
}

/// §2 — a random sample pulled from a lot and put through the required tests.
model Analysis {
  id          Int      @id @default(autoincrement())
  lotId       Int
  lot         Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  sampleRef   String
  method      String? // Spectro / Tensile / Hardness / Metallography
  performedAt DateTime @default(now()) @db.Timestamptz(3)
  /// Who physically ran the test. May be an outside laboratory, so it stays
  /// free text and is deliberately not an account.
  performedBy String?

  /// Who entered the result into the system. Always an account: this is the
  /// person the audit trail holds answerable for the record.
  recordedById Int
  recordedBy   User @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  /// PENDING | ACCEPTED | REJECTED
  status      String  @default("PENDING")
  conclusion  String?
  /// اتخاذ الإجراء المناسب في حالة عدم المطابقة
  actionTaken String?

  results AnalysisResult[]

  @@index([lotId])
  @@index([recordedById])
}

model AnalysisResult {
  id         Int      @id @default(autoincrement())
  analysisId Int
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  property     String // "C %", "Cr %", "Tensile strength"
  requiredMin  Float?
  requiredMax  Float?
  requiredText String?
  actual       Float?
  actualText   String?
  unit         String?
  /// null while pending; set by the domain comparison.
  pass         Boolean?
  sortOrder    Int      @default(0)

  @@index([analysisId])
}

// ─────────────────── 3–6 · the part traveller ───────────────────

/// One physical part (or batch) walking the stages. `currentStage` is the
/// inspection it is *waiting for*; RELEASED means it cleared the final one.
model Part {
  id           Int      @id @default(autoincrement())
  serialNumber String   @unique
  materialId   Int
  material     Material @relation(fields: [materialId], references: [id])
  lotId        Int?
  lot          Lot?     @relation(fields: [lotId], references: [id])

  batchQty Int @default(1)

  /// POST_ROUGHING | HEAT_TREATMENT | POST_GRINDING | FINAL | DONE
  currentStage String @default("POST_ROUGHING")
  /// IN_PROCESS | REWORK | RELEASED | REJECTED | HOLD
  status       String @default("IN_PROCESS")

  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  inspections Inspection[]
  events      PartEvent[]

  @@index([currentStage, status])
}

/// Append-only audit trail: every stage move and verdict is kept.
model PartEvent {
  id        Int      @id @default(autoincrement())
  partId    Int
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  at        DateTime @default(now()) @db.Timestamptz(3)
  /// INSPECTION | STAGE_ADVANCED | STATUS_CHANGE | CREATED
  kind      String
  stage     String?
  fromValue String?
  toValue   String?
  note      String?

  /// Who caused the event. The relation is the audit link; `actor` is the name
  /// snapshotted at the time, so the trail stays readable after a rename.
  actorId   Int
  actorUser User   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actor     String

  @@index([partId])
  @@index([actorId])
}

/// One filled-in checklist. Raw-material stages hang off `lot`, part stages
/// off `part`.
model Inspection {
  id     Int    @id @default(autoincrement())
  stage  String
  partId Int?
  part   Part?  @relation(fields: [partId], references: [id], onDelete: Cascade)
  lotId  Int?
  lot    Lot?   @relation(fields: [lotId], references: [id], onDelete: Cascade)

  /// Who signed this inspection. The relation proves identity; `inspector` is
  /// the name snapshotted at signing time so a later rename cannot rewrite a
  /// record that is already signed — the same reason the hardness window below
  /// is snapshotted.
  inspectorId   Int
  inspectorUser User   @relation(fields: [inspectorId], references: [id], onDelete: Restrict)
  inspector     String

  inspectedAt DateTime @default(now()) @db.Timestamptz(3)
  /// PENDING | ACCEPTED | REWORK | REJECTED | FURTHER_INVESTIGATION | RELEASED
  status      String   @default("PENDING")
  notes       String?

  /// Heat-treatment hardness reading, with the range snapshotted at
  /// inspection time so a later spec edit cannot rewrite history.
  hardnessValue Float?
  hardnessUnit  String?
  hardnessMin   Float?
  hardnessMax   Float?

  /// Final inspection extras.
  surfaceFinishRa Float?
  cmmRequired     Boolean @default(false)
  cmmReportRef    String?
  cmmReviewed     Boolean @default(false)

  checks       CheckResult[]
  measurements Measurement[]

  @@index([stage, status])
  @@index([partId])
  @@index([lotId])
  @@index([inspectorId])
}

/// One line of the stage checklist. `key` resolves to the AR/EN label in
/// `lib/domain/stages.ts`.
model CheckResult {
  id           Int        @id @default(autoincrement())
  inspectionId Int
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  key          String
  /// true = ok, false = not ok, null = not answered yet
  ok           Boolean?
  note         String?

  @@unique([inspectionId, key])
}

/// A measured dimension or GD&T callout. Nominal and tolerances are copied
/// from the feature so the record stays readable on its own.
model Measurement {
  id           Int        @id @default(autoincrement())
  inspectionId Int
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  featureId    Int?

  name      String
  kind      String  @default("DIMENSION")
  nominal   Float?
  tolMinus  Float   @default(0)
  tolPlus   Float   @default(0)
  gdtLimit  Float?
  actual    Float?
  unit      String  @default("mm")
  critical  Boolean @default(false)
  /// PASS | FAIL | PENDING — computed by the domain layer on save.
  result    String  @default("PENDING")
  sortOrder Int     @default(0)

  @@index([inspectionId])
}
